{  "cmake.options.advanced": {
    "build": {
      "statusBarVisibility": "visible"
    },
    "launch": {
      "statusBarVisibility": "hidden"
    },
    "debug": {
      "statusBarVisibility": "hidden"
    },
    "configurePreset": {
      "statusBarVisibility": "compact",
      "statusBarLength": 10
    },
    "buildPreset": {
      "statusBarVisibility": "compact",
      "statusBarLength": 10
    },
    "buildTarget": {
      "statusBarVisibility": "visible",
      "statusBarLength": 20
    },
    "launchTarget": {
      "statusBarVisibility": "visible",
      "statusBarLength": 20
    },
  },

    "clangd.arguments": [
        "--compile-commands-dir=${command:cmake.buildDirectory}"
    ]
}